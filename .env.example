# Copy this file to ".env" and fill in your key, or export these in your shell.
# Get a key at https://console.anthropic.com/ -> API Keys.

# Required for live AI reactions. If unset, the server runs in MOCK mode
# (deterministic stub reactions) so you can click around without a key.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-4-8 (strongest). For a friends game with
# ~9 calls per turn, claude-sonnet-4-6 or claude-haiku-4-5 cost much less and
# are plenty for persona role-play.
CLAUDE_MODEL=claude-opus-4-8

# Optional. Port the server listens on.
PORT=3000
